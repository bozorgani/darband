# ---------------------------------------------------------------------------
# قهوینو (Ghahvino) — نمونهٔ متغیرهای محیطی
# این فایل هیچ مقدار محرمانه‌ای ندارد و باید در مخزن باقی بماند.
# برای اجرای محلی: cp .env.example .env.local
# ---------------------------------------------------------------------------

# آدرس کانونی سایت؛ مبنای metadataBase، canonical، sitemap.xml، robots.txt و JSON-LD.
# باید https باشد، بدون www و بدون اسلش انتهایی. اگر تعریف نشود یا در محیط
# production روی localhost تنظیم شده باشد، مقدار https://ghahvino.ir استفاده می‌شود.
NEXT_PUBLIC_SITE_URL=https://ghahvino.ir

# این پروژه فرانت‌اند-only است: بدون بک‌اند، پایگاه‌داده، درگاه پرداخت و پنل پیامک.
# هیچ کلید API یا مقدار محرمانه‌ای لازم نیست و نباید اضافه شود.
